#############################
# Unraid Server Health Monitor
# config.conf
#############################

# Pfade (Unraid-Defaults – nur ändern wenn nötig)
# CACHE_PATH: echter Mount unter /mnt (df -hT), z.B. /mnt/cacheintern
# Linux: Groß/Kleinschreibung zählt – /mnt/Cacheintern ≠ /mnt/cacheintern
# (USHM normalisiert case-insensitive, korrekt bleibt der df-Pfad)
CACHE_PATH=/mnt/cache
APPDATA_PATH=/mnt/user/appdata
DOCKER_PATH=/var/lib/docker
DATA_DIR=

# Anzahl Top-Verzeichnisse im Report
TOP_N=20

#############################
# Mail
#############################

MAIL_ENABLED=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
# true bei Port 465 (SMTPS); bei 587 meist false + SMTP_TLS=true
SMTP_SSL=false
# Verbindungs-Timeout Sekunden / Anzahl Versuche
SMTP_TIMEOUT=60
SMTP_RETRIES=3
MAIL_FROM=
MAIL_TO=
# daily | warn | crit | always
# daily = auch bei OK (empfohlen, analog Pushover Daily)
MAIL_ON=daily

#############################
# Pushover
#############################

PUSHOVER_ENABLED=false
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Daily Report auch ohne Alarm senden
PUSHOVER_DAILY=true

#############################
# Schwellwerte
#############################

# Cache SSD: freier Speicher in Prozent (Warnung/Kritisch wenn darunter)
CACHE_WARN=20
CACHE_CRIT=10

# Docker Image: Belegung in Prozent (Warnung/Kritisch wenn darüber)
DOCKER_WARN=70
DOCKER_CRIT=90

# AppData-Wachstum seit letztem Lauf in MB
APP_WARN_MB=500
APP_CRIT_MB=2000

# Container-Logs Gesamtgröße in MB
LOG_WARN_MB=500
LOG_CRIT_MB=2000

# Docker Writable Layer Belegung in Prozent (0 = deaktiviert)
DOCKER_LAYER_WARN=0
DOCKER_LAYER_CRIT=0

# SMART Temperatur in °C
SMART_WARN=55
SMART_CRIT=65

# SSD Remaining Life in Prozent (später / alle Disks)
SSD_LIFE_WARN=20
SSD_LIFE_CRIT=10

#############################
# Disks, Parity & SMART (v2.1)
#############################

# Inventar: beim Start prüfen ob Disks hinzugekommen/entfernt/ersetzt wurden
USHM_INVENTORY_ENABLED=true

# Array I/O (numErrors) für Parity + Data + Cache – gruppiert im Report
USHM_ARRAY_ENABLED=true
PARITY_ERROR_WARN=1
PARITY_ERROR_CRIT=1
# Data/Cache I/O (Default = Parity-Schwellwerte)
DISK_ERROR_WARN=1
DISK_ERROR_CRIT=1

# SMART aller Disks (parity|all). Standby-Disks werden nicht aufgeweckt.
USHM_SMART_ENABLED=true
SMART_SCOPE=all
SMART_REALLOC_WARN=1
SMART_PENDING_WARN=1
SMART_UNCORR_WARN=1
SMART_CRC_WARN=10
# true = jede Erhöhung seit letztem Lauf alarmieren
SMART_DELTA_ALERT=true

#############################
# Verhalten
#############################

# true = nur Report, keine Alarme/Mails/Pushover
DRY_RUN=false

# Log-Level: debug | info | warn | error
LOG_LEVEL=info
